---
import { NAV_MENU } from "../consts";
import HeaderLink from "./HeaderLink.astro";
---

<div class="hidden lg:block mx-auto">
  <ul class="menu menu-horizontal gap-x-4">
    {
      NAV_MENU.map((item) => (
        <li>
          <HeaderLink href={item.url} class="hover:bg-white">
            <span data-i18n="en">{item.title}</span>
            <span data-i18n="es" style="display:none">{item.es}</span>
          </HeaderLink>
        </li>
      ))
    }
  </ul>
</div>
