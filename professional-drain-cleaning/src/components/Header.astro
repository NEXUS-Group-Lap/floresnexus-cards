---
import Navabar from "../components/Navbar.astro";
import Logo from "../components/Logo.astro";
import { Icon } from "astro-icon/components";
import { PHONE_DISPLAY, PHONE_TEL } from "../consts";
---

<header class="header">
  <div class="navbar w-full bg-white">
    <div class="container flex items-center gap-3">
      <Logo />

      <Navabar />

      <div class="flex gap-2 sm:gap-3 items-center ml-auto">
        <a
          href={PHONE_TEL}
          class="hidden sm:inline-flex items-center gap-2 btn bg-main border-main text-white rounded-lg hover:bg-dark"
        >
          <Icon name="lucide:phone-call" size={16} />
          {PHONE_DISPLAY}
        </a>

        <div
          class="flex items-center rounded-md border border-dark/20 overflow-hidden text-sm font-semibold"
          role="group"
          aria-label="Language / Idioma"
        >
          <button
            type="button"
            data-lang-btn="en"
            aria-pressed="true"
            class="min-w-11 min-h-11 px-2.5 flex items-center justify-center bg-main text-white"
          >
            EN
          </button>
          <button
            type="button"
            data-lang-btn="es"
            aria-pressed="false"
            class="min-w-11 min-h-11 px-2.5 flex items-center justify-center text-dark hover:bg-gray-100"
          >
            ES
          </button>
        </div>

        <div class="flex-none lg:hidden">
          <label
            for="my-drawer-2"
            aria-label="open sidebar"
            class="btn btn-square btn-ghost ml-2"
          >
            <Icon name="lucide:menu" />
          </label>
        </div>
      </div>
    </div>
  </div>
</header>
