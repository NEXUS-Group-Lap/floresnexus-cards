---
// Import the global.css file here so that it is included on
// all pages through the use of the <BaseHead /> component.
import "../styles/global.css";
import type { ImageMetadata } from "astro";
import FallbackImage from "../assets/og_1200x630.jpg";
import { SITE_DESCRIPTION, SITE_TITLE, LEGAL_NAME, BASE, BUSINESS_STREET, BUSINESS_CITY, BUSINESS_STATE, BUSINESS_ZIP, SERVICE_AREAS } from "../consts";
import { Font } from "astro:assets";

interface Props {
  title: string;
  description: string;
  image?: ImageMetadata;
}

const canonicalURL = new URL(Astro.url.pathname, Astro.site);

const {
  title = SITE_TITLE,
  description = SITE_DESCRIPTION,
  image = FallbackImage,
} = Astro.props;
---

<!-- Global Metadata -->
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<link rel="icon" type="image/svg+xml" href={`${BASE}favicon.svg`} />
<link rel="icon" href={`${BASE}favicon.ico`} />
<link rel="sitemap" href={`${BASE}sitemap-index.xml`} />
<link rel="manifest" href={`${BASE}favicon/site.webmanifest`} />
<meta name="generator" content={Astro.generator} />

<Font cssVariable="--font-atkinson" preload />
<Font cssVariable="--font-display" preload />
<Font cssVariable="--font-label" preload />

<!-- Canonical URL -->
<link rel="canonical" href={canonicalURL} />

<!-- Primary Meta Tags -->
<title>{title.includes(SITE_TITLE) ? title : `${title} | ${SITE_TITLE}`}</title>
<meta name="title" content={title} />
<meta name="description" content={description} />
<meta
  name="keywords"
  content="drain cleaning Southwest Florida, drain cleaning North Fort Myers, drain cleaning Cape Coral, emergency plumber North Fort Myers, sewer line cleaning, camera drain inspection, water heater installation, bathroom remodel plumbing, well water systems, underground plumbing, residential plumbing, commercial plumbing, 24/7 emergency plumber"
/>

<!-- Open Graph / Facebook -->
<meta property="og:type" content="website" />
<meta property="og:url" content={Astro.url} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={new URL(image.src, Astro.url)} />

<!-- Twitter -->
<meta property="twitter:card" content="summary_large_image" />
<meta property="twitter:url" content={Astro.url} />
<meta property="twitter:title" content={title} />
<meta property="twitter:description" content={description} />
<meta property="twitter:image" content={new URL(image.src, Astro.url)} />

<!-- JSON-LD Structured Data -->
<script type="application/ld+json" is:inline set:html={JSON.stringify({
  "@context": "https://schema.org",
  "@type": "Plumber",
  "name": SITE_TITLE,
  "legalName": LEGAL_NAME,
  "description": SITE_DESCRIPTION,
  "telephone": "+12397910937",
  "address": {
    "@type": "PostalAddress",
    "streetAddress": BUSINESS_STREET,
    "addressLocality": BUSINESS_CITY,
    "addressRegion": BUSINESS_STATE,
    "postalCode": BUSINESS_ZIP,
    "addressCountry": "US",
  },
  "areaServed": [
    ...SERVICE_AREAS.map((city) => ({ "@type": "City", "name": city })),
    { "@type": "AdministrativeArea", "name": "Southwest Florida" },
  ],
  "openingHoursSpecification": {
    "@type": "OpeningHoursSpecification",
    "dayOfWeek": ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday", "Sunday"],
    "opens": "00:00",
    "closes": "23:59",
  },
  "paymentAccepted": "Cash, Check, Zelle",
  "url": Astro.site ? new URL(BASE, Astro.site).toString() : BASE,
})} />
