---
import BaseLayout from '../layouts/BaseLayout.astro';
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import { groupByCategory } from '../lib/categories';
import { categoryImage, HERO_BG_IMAGE, RECURSOS_IMAGE } from '../lib/category-images';
import HeroExperience from '../components/hero-experience';
import { withBase } from '../lib/url';

const guides = await getCollection('guides');
const groups = groupByCategory(guides);
---
<BaseLayout title="Migración Simple | Información oficial explicada fácil">
  <section class="hero">
    <div class="hero-bg" aria-hidden="true">
      <Image src={HERO_BG_IMAGE.src} alt="" widths={[800, 1400, 2000]} sizes="100vw" loading="eager" fetchpriority="high" />
    </div>
    <div class="glow glow-red" style="width:520px; height:520px; top:-220px; right:-120px;" aria-hidden="true"></div>
    <div class="glow glow-white" style="width:380px; height:380px; bottom:-180px; left:-140px;" aria-hidden="true"></div>
    <div class="container">
      <HeroExperience client:load />
      <div class="notice hero-disclaimer">
        <strong>Antes de usar esta información:</strong> no somos USCIS, ICE, EOIR ni un bufete de abogados. Es contenido educativo basado en fuentes oficiales. <a href={withBase('/legal/disclaimer')}>Leer aviso legal →</a>
      </div>
    </div>
  </section>

  <section class="section" id="temas">
    <div class="container">
      <div class="section-head" data-reveal><div><h2>Explorar por tema</h2><p>Organizado por situaciones reales, no solo por números de formularios.</p></div></div>
      <nav class="category-grid" aria-label="Temas">
        {groups.map(({ category, slug, items }, i) => (
          <a class="category" href={withBase(`/guias#${slug}`)} data-reveal style={`--reveal-delay:${(i % 8) * 50}ms`}>
            <span class="category-photo">
              <Image src={categoryImage(category).src} alt="" widths={[160, 320]} sizes="160px" loading="lazy" />
            </span>
            <span class="category-body">
              <strong>{category}</strong>
              <span>{items.length} guía{items.length === 1 ? '' : 's'} disponible{items.length === 1 ? '' : 's'}</span>
            </span>
          </a>
        ))}
      </nav>
    </div>
  </section>

  <section class="section" id="recursos">
    <div class="container">
      <div class="section-head" data-reveal><div><h2>Recursos recomendados</h2><p>Contenido complementario de otras organizaciones, no de Migración Simple.</p></div></div>
      <a href={withBase('/recursos')} class="category-banner recursos-teaser" data-reveal aria-label="Ver todos los recursos recomendados">
        <Image src={RECURSOS_IMAGE.src} alt={RECURSOS_IMAGE.alt} widths={[500, 900, 1400]} sizes="(max-width: 850px) 100vw, 1120px" loading="lazy" />
        <span class="recursos-teaser-overlay">
          <span class="recursos-teaser-text">
            <strong>Cuentas oficiales, organizaciones comunitarias y canales recomendados</strong>
            <span>Facebook de USCIS/ICE/EOIR, apoyo local en el suroeste de Florida y canales de YouTube.</span>
          </span>
          <span class="recursos-teaser-cta btn-pill btn-pill--light">
            <span>Ver todos los recursos</span>
            <span class="btn-pill-icon">
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M7 17 17 7M9 7h8v8" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </span>
          </span>
        </span>
      </a>
      <div class="notice" data-reveal>
        <strong>Antes de seguir estas páginas:</strong> no son parte de Migración Simple y no verificamos legalmente todo lo que publican. Prioriza siempre las fuentes oficiales (USCIS, ICE, EOIR) y confirma cualquier duda con un abogado de inmigración con licencia.
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container notice" data-reveal>
      <strong>Regla editorial:</strong> cada guía incluye la agencia responsable, la fuente oficial y la fecha de última revisión. Cuando una regla pueda cambiar, debe volver a verificarse antes de actualizar el artículo.
    </div>
  </section>
</BaseLayout>
