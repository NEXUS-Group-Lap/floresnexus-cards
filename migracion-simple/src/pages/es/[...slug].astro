---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { Image } from 'astro:assets';
import { getCollection, render } from 'astro:content';
import { getAgency, detectAgency } from '../../lib/agencies';
import { categoryImage } from '../../lib/category-images';
import { withBase } from '../../lib/url';

export async function getStaticPaths() {
  const guides = await getCollection('guides');
  return guides.map(guide => ({
    params: { slug: guide.data.path.replace(/^\/es\//, '') },
    props: { guide }
  }));
}

const { guide } = Astro.props;
const { Content } = await render(guide);
const reviewed = guide.data.lastReviewed.toLocaleDateString('es-US', { year: 'numeric', month: 'long', day: 'numeric' });
const primarySource = { ...guide.data.officialSource, agency: detectAgency(guide.data.officialSource.label) };
const otherSources = guide.data.additionalSources.map(s => ({ ...s, agency: detectAgency(s.label) }));
const banner = categoryImage(guide.data.category);
---
<BaseLayout title={`${guide.data.title} | Migración Simple`} description={guide.data.description}>
  <div class="article-wrap">
    <div class="breadcrumbs"><a href={withBase('/')}>Inicio</a> / <a href={withBase('/guias')}>Guías</a> / {guide.data.category}</div>
    <article class="article">
      {banner && (
        <figure class="category-banner article-banner">
          <Image src={banner.src} alt="" widths={[500, 900, 1400]} sizes="(max-width: 850px) 100vw, 820px" loading="eager" />
        </figure>
      )}
      <span class="eyebrow" data-reveal>{guide.data.category}</span>
      <h1 data-reveal style="--reveal-delay:60ms">{guide.data.title}</h1>
      <p class="lead" data-reveal style="--reveal-delay:110ms">{guide.data.description}</p>
      <div class="article-meta" data-reveal style="--reveal-delay:160ms">
        {guide.data.agency.map(a => {
          const info = getAgency(a);
          return (
            <span class="pill agency-pill" style={`--pill-color:${info.color};--pill-soft:${info.soft}`} title={info.full}>
              <span class="agency-dot" aria-hidden="true"></span>{a}
            </span>
          );
        })}
        <span class="pill">
          <svg class="pill-icon" width="12" height="12" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M12 8v5l3 2M21 12a9 9 0 1 1-9-9 9 9 0 0 1 9 9Z" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
          Revisado: {reviewed}
        </span>
      </div>
      <Content />

      <section class="sources-panel" aria-labelledby="sources-heading" data-reveal>
        <div class="sources-panel-head">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M9 12h6M9 16h6M9 8h1M13 3H8a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h8a2 2 0 0 0 2-2V8l-5-5Z" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
          <div>
            <strong id="sources-heading">Verifica esta información en la fuente oficial</strong>
            <p>Estos botones te llevan directo a los sitios del gobierno de EE. UU. — no a páginas de terceros.</p>
          </div>
        </div>
        <ul class="source-list">
          <li>
            <a class="source-chip source-chip--primary" style={`--chip-color:${primarySource.agency.color};--chip-soft:${primarySource.agency.soft}`} href={primarySource.url} target="_blank" rel="noopener noreferrer">
              <span class="source-chip-icon">{primarySource.agency.name.slice(0, 1)}</span>
              <span class="source-chip-text">
                <span class="source-chip-sub">Fuente principal · {primarySource.agency.name}</span>
                <span class="source-chip-label">{primarySource.label}</span>
              </span>
              <svg class="source-chip-arrow" width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M7 17 17 7M9 7h8v8" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </a>
          </li>
          {otherSources.map(source => (
            <li>
              <a class="source-chip" style={`--chip-color:${source.agency.color};--chip-soft:${source.agency.soft}`} href={source.url} target="_blank" rel="noopener noreferrer">
                <span class="source-chip-icon">{source.agency.name.slice(0, 1)}</span>
                <span class="source-chip-text">
                  <span class="source-chip-sub">{source.agency.name}</span>
                  <span class="source-chip-label">{source.label}</span>
                </span>
                <svg class="source-chip-arrow" width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M7 17 17 7M9 7h8v8" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
              </a>
            </li>
          ))}
        </ul>
      </section>

      <p class="notice" style="margin-top:24px"><strong>Importante:</strong> esta guía es informativa y no constituye asesoría legal. Para decisiones sobre un caso individual, considera consultar a un abogado de inmigración o representante acreditado autorizado.</p>
    </article>
  </div>
</BaseLayout>
