---
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import { withBase } from '../lib/url';
const {
  title = 'Migración Simple',
  description = 'Información migratoria oficial de Estados Unidos explicada en palabras simples.'
} = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site ?? Astro.url.origin);
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="theme-color" content="#dbe9fb" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <title>{title}</title>
    <ClientRouter />
    <noscript><style>[data-reveal] { opacity: 1 !important; transform: none !important; }</style></noscript>
  </head>
  <body>
    <a class="skip-link" href="#main-content">Saltar al contenido principal</a>
    <header class="site-header">
      <div class="container header-inner">
        <div class="brand">
          <a href={withBase('/')}>
            <span class="brand-word">Migración <em>Simple</em></span>
          </a>
          <small>Un sitio de <a href="https://floresnexus.com" target="_blank" rel="noopener">FloresNexus.com</a></small>
        </div>
        <nav class="nav-desktop" aria-label="Navegación principal">
          <a href={withBase('/guias')}>Guías</a>
          <a href={withBase('/#temas')}>Temas</a>
          <a href={withBase('/recursos')}>Recursos</a>
          <a href={withBase('/acerca')}>Acerca de</a>
          <a href={withBase('/legal/disclaimer')}>Aviso legal</a>
        </nav>
        <button id="nav-toggle" class="nav-toggle" type="button" aria-expanded="false" aria-controls="nav-mobile">
          <span class="nav-toggle-bar"></span>
          <span class="visually-hidden">Abrir menú de navegación</span>
        </button>
      </div>
      <nav id="nav-mobile" class="nav-mobile container" aria-label="Navegación principal (móvil)" hidden>
        <a href={withBase('/guias')}>Guías</a>
        <a href={withBase('/#temas')}>Temas</a>
        <a href={withBase('/recursos')}>Recursos</a>
        <a href={withBase('/acerca')}>Acerca de</a>
        <a href={withBase('/legal/disclaimer')}>Aviso legal</a>
      </nav>
    </header>
    <main id="main-content"><slot /></main>
    <footer class="footer">
      <div class="glow glow-red" style="width:420px; height:420px; bottom:-260px; left:50%; transform:translateX(-50%); opacity:.6;" aria-hidden="true"></div>
      <div class="container footer-grid">
        <div>
          <strong>Migración Simple</strong><br />
          Un sitio de <a href="https://floresnexus.com" target="_blank" rel="noopener">FloresNexus.com</a><br />
          Información educativa basada en fuentes oficiales del Gobierno de EE. UU.
        </div>
        <div class="footer-links">
          <a href={withBase('/acerca')}>Acerca de</a>
          <a href={withBase('/legal/disclaimer')}>Aviso legal</a>
          <a href={withBase('/legal/privacy')}>Privacidad</a>
        </div>
      </div>
    </footer>
    <script>
      function initNav() {
        const toggle = document.querySelector<HTMLElement>('#nav-toggle');
        const mobileNav = document.querySelector<HTMLElement>('#nav-mobile');
        if (!toggle || !mobileNav || toggle.dataset.bound) return;
        toggle.dataset.bound = 'true';
        const close = () => {
          toggle.setAttribute('aria-expanded', 'false');
          mobileNav.hidden = true;
        };
        toggle.addEventListener('click', () => {
          const open = toggle.getAttribute('aria-expanded') === 'true';
          toggle.setAttribute('aria-expanded', String(!open));
          mobileNav.hidden = open;
        });
        mobileNav.addEventListener('click', (e) => {
          if (e.target instanceof HTMLElement && e.target.tagName === 'A') close();
        });
        document.addEventListener('keydown', (e) => {
          if (e.key === 'Escape') close();
        });
        matchMedia('(min-width: 851px)').addEventListener('change', (e) => {
          if (e.matches) close();
        });
      }

      // Revela con un fundido + desplazamiento suave cualquier elemento marcado
      // con data-reveal cuando entra en el viewport. Se reengancha en cada
      // navegación con ClientRouter (astro:page-load cubre la carga inicial y
      // las siguientes), y respeta prefers-reduced-motion vía CSS.
      function initReveal() {
        const els = Array.from(document.querySelectorAll<HTMLElement>('[data-reveal]'));
        if (els.length === 0) return;
        if (!('IntersectionObserver' in window) || matchMedia('(prefers-reduced-motion: reduce)').matches) {
          els.forEach((el) => el.classList.add('is-visible'));
          return;
        }
        const io = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (entry.isIntersecting) {
                entry.target.classList.add('is-visible');
                io.unobserve(entry.target);
              }
            }
          },
          { threshold: 0.12, rootMargin: '0px 0px -40px 0px' }
        );
        els.forEach((el) => {
          if (!el.classList.contains('is-visible')) io.observe(el);
        });
      }

      document.addEventListener('astro:page-load', initNav);
      document.addEventListener('astro:page-load', initReveal);
    </script>
  </body>
</html>
