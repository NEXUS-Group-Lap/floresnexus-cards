---
import { siteConfig } from '../config.ts';
import { Icon } from 'astro-icon/components';
import { testimonialsData } from '../content/testimonials';

const businessIconMap: Record<string, string> = {
  'Rivera Plumbing Co.': 'heroicons:wrench-screwdriver',
  'MG Cleaning Services': 'heroicons:sparkles',
  'Hernandez Lawn Pros': 'heroicons:scissors',
  'Torres Auto Detail': 'heroicons:truck',
  'Castillo Roofing LLC': 'heroicons:home',
  'Morales Realty Group': 'heroicons:building-office-2',
};

const platforms = [
  { icon: 'simple-icons:google', label: 'Google' },
  { icon: 'simple-icons:facebook', label: 'Facebook' },
  { icon: 'simple-icons:instagram', label: 'Instagram' },
  { icon: 'simple-icons:whatsapp', label: 'WhatsApp' },
  { icon: 'simple-icons:wordpress', label: 'WordPress' },
  { icon: 'simple-icons:youtube', label: 'YouTube' },
  { icon: 'simple-icons:yelp', label: 'Yelp' },
  { icon: 'simple-icons:stripe', label: 'Stripe' },
  { icon: 'simple-icons:mailchimp', label: 'Mailchimp' },
  { icon: 'simple-icons:googlemaps', label: 'Google Maps' },
  { icon: 'simple-icons:square', label: 'Square' },
  { icon: 'simple-icons:calendly', label: 'Calendly' },
];
---

<section class="relative border-t border-[#D8D5CD] bg-[#F7F5F0] px-4 py-20 sm:px-6 lg:px-8">
  <div class="mx-auto max-w-7xl">
    <div class="scroll-fade-up mx-auto mb-16 max-w-3xl text-center">
      <h2 class="text-mono-black mb-4 text-4xl font-bold sm:text-5xl">
        {siteConfig.testimonials.title}
      </h2>
      <p class="text-mono-dark text-xl">
        {siteConfig.testimonials.subtitle}
      </p>
    </div>

    <div class="mb-20 grid grid-cols-1 gap-8 md:grid-cols-2 lg:grid-cols-3">
      {
        testimonialsData.map((testimonial, index) => (
          <div
            class={`scroll-fade-up rounded-2xl border border-[#D8D5CD] bg-white p-8 card-shadow border-l-4 border-l-[#C79A4B] stagger-${(index % 9) + 1}`}
          >
            <div class="mb-4 flex">
              {Array.from({ length: testimonial.rating }).map(() => (
                <Icon
                  name="heroicons:star-solid"
                  class="h-5 w-5 text-[#C79A4B]"
                />
              ))}
            </div>
            <p class="text-mono-dark mb-6 leading-relaxed">
              "{testimonial.quote}"
            </p>
            <div class="flex items-center justify-between">
              <div class="flex items-center">
                <div class="mr-4 flex h-12 w-12 items-center justify-center rounded-full bg-[#0B0B0B] font-semibold text-white">
                  {testimonial.initials}
                </div>
                <div>
                  <div class="text-mono-black font-semibold">
                    {testimonial.author}
                  </div>
                  <div class="text-mono-gray text-sm">{testimonial.role}</div>
                </div>
              </div>
              {businessIconMap[testimonial.company] && (
                <Icon
                  name={businessIconMap[testimonial.company]}
                  class="h-6 w-6 text-mono-gray opacity-50"
                />
              )}
            </div>
          </div>
        ))
      }
    </div>

    <div class="scroll-fade-up">
      <div class="rounded-2xl border border-[#D8D5CD] bg-white p-12 card-shadow">
        <p class="text-mono-gray mb-2 text-center text-sm tracking-wide uppercase">
          Tools We Can Work With When Needed
        </p>
        <p class="text-mono-gray mb-10 text-center text-xs">
          Some tools and integrations are available only in custom plans or as paid upgrades.
        </p>
        <div
          class="mx-auto grid max-w-6xl grid-cols-3 items-center gap-12 sm:grid-cols-4 md:grid-cols-6"
        >
          {
            platforms.map((platform) => (
              <div class="flex flex-col items-center justify-center gap-3">
                <Icon
                  name={platform.icon}
                  class="h-10 w-10 text-[#6B6B6B]"
                />
                <span class="text-mono-gray text-xs font-medium">
                  {platform.label}
                </span>
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </div>
</section>
