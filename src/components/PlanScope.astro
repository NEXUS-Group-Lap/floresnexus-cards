---
import { siteConfig } from '../config.ts';
import { Icon } from 'astro-icon/components';
---

<section class="border-t border-[#D8D5CD] bg-white px-4 py-20 sm:px-6 lg:px-8">
  <div class="mx-auto max-w-5xl">

    <div class="scroll-fade-up mx-auto mb-12 max-w-3xl text-center">
      <h2 class="text-mono-black mb-4 text-4xl font-bold sm:text-5xl">
        {siteConfig.planScope.title}
      </h2>
      <p class="text-mono-dark text-xl leading-relaxed">
        {siteConfig.planScope.intro}
      </p>
    </div>

    <!-- Two paragraph cards -->
    <div class="scroll-fade-up mb-10 grid grid-cols-1 gap-6 md:grid-cols-2">
      <div class="rounded-2xl border border-[#D8D5CD] bg-[#F7F5F0] p-7">
        <p class="text-xs font-semibold uppercase tracking-wide text-mono-gray mb-3">Base Plans Include</p>
        <p class="text-mono-dark leading-relaxed">{siteConfig.planScope.basePlans}</p>
      </div>
      <div class="rounded-2xl border border-[#D8D5CD] bg-[#F7F5F0] p-7">
        <p class="text-xs font-semibold uppercase tracking-wide text-mono-gray mb-3">Can Be Added Separately</p>
        <p class="text-mono-dark leading-relaxed">{siteConfig.planScope.addOns}</p>
      </div>
    </div>

    <!-- Add-on items grid -->
    <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {
        siteConfig.planScope.addOnItems.map((item, index) => (
          <div class={`scroll-fade-up rounded-2xl border border-[#D8D5CD] bg-white p-6 card-shadow stagger-${index + 1}`}>
            <div class="mb-3 flex items-center gap-3">
              <div class="flex h-8 w-8 flex-shrink-0 items-center justify-center rounded-lg bg-[#F7F5F0]">
                <Icon name="heroicons:plus" class="h-4 w-4 text-[#0B0B0B]" />
              </div>
              <h3 class="text-mono-black font-semibold">{item.label}</h3>
            </div>
            <p class="text-sm leading-relaxed text-mono-dark">{item.detail}</p>
          </div>
        ))
      }
    </div>

    <!-- Production note -->
    <div class="scroll-fade-up mt-10 rounded-2xl border border-[#D8D5CD] bg-[#0B0B0B] px-8 py-6 text-center">
      <p class="text-sm font-medium text-white/80">{siteConfig.planScope.production}</p>
    </div>

  </div>
</section>
