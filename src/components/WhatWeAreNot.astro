---
import { siteConfig } from '../config.ts';
import { Icon } from 'astro-icon/components';
---

<section
  class="border-t border-[#D8D5CD] bg-white px-4 py-20 sm:px-6 lg:px-8"
>
  <div class="mx-auto max-w-5xl">
    <div class="scroll-fade-up mx-auto mb-12 max-w-3xl text-center">
      <h2 class="text-mono-black mb-4 text-4xl font-bold sm:text-5xl">
        {siteConfig.whatWeAreNot.title}
      </h2>
      <p class="text-mono-dark text-xl">
        {siteConfig.whatWeAreNot.subtitle}
      </p>
    </div>

    <div class="grid grid-cols-1 gap-6 md:grid-cols-2">
      {
        siteConfig.whatWeAreNot.items.map((item, index) => (
          <div
            class={`scroll-fade-up flex items-start gap-4 rounded-2xl border border-[#D8D5CD] bg-white p-6 card-shadow stagger-${index + 1}`}
          >
            <div class="mt-0.5 flex h-10 w-10 flex-shrink-0 items-center justify-center rounded-full bg-[#F7F5F0] border border-[#D8D5CD]">
              <Icon name="heroicons:x-mark" class="h-5 w-5 text-[#0B0B0B]" />
            </div>
            <div>
              <h3 class="text-mono-black mb-1 font-semibold">{item.statement}</h3>
              <p class="text-mono-dark text-sm leading-relaxed">{item.meaning}</p>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>
