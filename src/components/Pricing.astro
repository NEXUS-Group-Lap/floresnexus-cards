---
import { siteConfig } from '../config.ts';
import { mainPlans, nexusMiniCardPlan } from '../content/plans.ts';
import { Icon } from 'astro-icon/components';
---

<section
  id="pricing"
  class="relative border-t border-[#D8D5CD] bg-[#F7F5F0] px-4 py-20 sm:px-6 lg:px-8"
>
  <div class="mx-auto max-w-7xl">
    <div class="scroll-fade-up mx-auto mb-16 max-w-3xl text-center">
      <h2 class="text-mono-black mb-4 text-4xl font-bold sm:text-5xl">
        {siteConfig.pricing.title}
      </h2>
      <p class="text-mono-dark text-xl">
        {siteConfig.pricing.subtitle}
      </p>
    </div>

    <!-- Main Plans -->
    <div class="mx-auto mb-12 grid max-w-6xl grid-cols-1 gap-8 md:grid-cols-3">
      {
        mainPlans.map((plan, index) =>
          plan.featured ? (
            <div class="scroll-fade-up scale-105 transform rounded-2xl border-2 border-[#C79A4B] card-shadow-featured">
              <div class="flex h-full flex-col rounded-2xl bg-[#111111] p-8">
                <div class="mb-4 inline-block self-start rounded-full bg-[#C79A4B] px-3 py-1 text-xs font-semibold text-[#0B0B0B]">
                  {plan.badge}
                </div>
                <h3 class="mb-3 text-2xl font-bold text-white">{plan.name}</h3>
                <div class="mb-1">
                  <span class="text-sm text-white/60">Setup: </span>
                  <span class="text-xl font-bold text-white">{plan.setup}</span>
                </div>
                <div class="mb-6">
                  <span class="text-4xl font-bold text-white">{plan.monthly}</span>
                  <span class="text-white/60">{plan.period}</span>
                </div>
                <p class="mb-6 text-sm text-white/70">{plan.description}</p>
                <ul class="mb-6 flex-1 space-y-3">
                  {plan.features.map((feature) => (
                    <li class="flex items-start">
                      <Icon
                        name="heroicons:check"
                        class="mt-0.5 mr-3 h-4 w-4 flex-shrink-0 text-[#C79A4B]"
                      />
                      <span class="text-sm text-white/90">{feature}</span>
                    </li>
                  ))}
                </ul>
                {plan.notIncluded && (
                  <p class="mb-6 text-xs leading-relaxed text-white/40">
                    {plan.notIncluded}
                  </p>
                )}
                <a
                  href={plan.detailPageUrl}
                  class="btn-featured mt-auto px-6 py-3"
                >
                  {plan.cardButtonText}
                </a>
                <a
                  href={plan.detailPageUrl}
                  class="mt-3 block text-center text-xs text-white/50 underline underline-offset-2"
                >
                  + View details
                </a>
              </div>
            </div>
          ) : (
            <div
              class={`${index === 0 ? 'scroll-fade-left' : 'scroll-fade-right'} flex flex-col rounded-2xl border border-[#D8D5CD] bg-white p-8 card-shadow`}
            >
              <h3 class="text-mono-black mb-3 text-2xl font-bold">
                {plan.name}
              </h3>
              <div class="mb-1">
                <span class="text-mono-gray text-sm">Setup: </span>
                <span class="text-mono-black text-xl font-bold">{plan.setup}</span>
              </div>
              <div class="mb-6">
                <span class="text-mono-black text-4xl font-bold">{plan.monthly}</span>
                <span class="text-mono-gray">{plan.period}</span>
              </div>
              <p class="text-mono-dark mb-6 text-sm">{plan.description}</p>
              <ul class="mb-6 flex-1 space-y-3">
                {plan.features.map((feature) => (
                  <li class="flex items-start">
                    <Icon
                      name="heroicons:check"
                      class="mt-0.5 mr-3 h-4 w-4 flex-shrink-0 text-[#0B0B0B]"
                    />
                    <span class="text-mono-dark text-sm">{feature}</span>
                  </li>
                ))}
              </ul>
              {plan.notIncluded && (
                <p class="text-mono-gray mb-6 text-xs leading-relaxed">
                  {plan.notIncluded}
                </p>
              )}
              <a
                href={plan.detailPageUrl}
                class={`mt-auto block w-full px-6 py-3 text-center ${plan.requestQuote ? 'btn-primary' : 'btn-secondary'}`}
              >
                {plan.cardButtonText}
              </a>
              <a
                href={plan.detailPageUrl}
                class="text-mono-gray mt-3 block text-center text-xs underline underline-offset-2"
              >
                + View details
              </a>
            </div>
          ),
        )
      }
    </div>

    <!-- Nexus Mini Card -->
    <div class="scroll-fade-up mx-auto max-w-4xl">
      <div class="rounded-2xl border border-[#D8D5CD] bg-white p-8 card-shadow">
        <div class="mb-6 flex flex-wrap items-center gap-3">
          <h3 class="text-mono-black text-2xl font-bold">
            {nexusMiniCardPlan.name}
          </h3>
          <span
            class="rounded-full border border-[#D8D5CD] bg-[#F7F5F0] px-3 py-0.5 text-xs font-semibold text-mono-gray"
          >
            {nexusMiniCardPlan.tag}
          </span>
        </div>

        <div class="grid grid-cols-1 gap-8 md:grid-cols-2">
          <div>
            <p class="text-mono-dark mb-4">
              {nexusMiniCardPlan.description}
            </p>
            <div class="mb-4 flex flex-wrap gap-6">
              <div>
                <span class="text-mono-gray text-sm">Setup: </span>
                <span class="text-mono-black font-bold">{nexusMiniCardPlan.setup}</span>
              </div>
              <div>
                <span class="text-mono-black font-bold">{nexusMiniCardPlan.monthly}</span
                ><span class="text-mono-gray">/month</span>
                <span class="text-mono-gray mx-2 text-sm">or</span>
                <span class="text-mono-black font-bold">{nexusMiniCardPlan.annual}</span
                ><span class="text-mono-gray">/year</span>
              </div>
            </div>
            <p class="text-mono-gray mb-6 text-xs leading-relaxed">
              {nexusMiniCardPlan.disclaimer}
            </p>
            <a
              href={nexusMiniCardPlan.detailPageUrl}
              class="btn-secondary inline-block px-6 py-3"
            >
              {nexusMiniCardPlan.cardButtonText}
            </a>
            <a
              href={nexusMiniCardPlan.detailPageUrl}
              class="text-mono-gray mt-3 block text-sm underline underline-offset-2"
            >
              + View details
            </a>
          </div>

          <ul class="space-y-2">
            {
              nexusMiniCardPlan.features.map((feature) => (
                <li class="flex items-start">
                  <Icon
                    name="heroicons:check"
                    class="mt-0.5 mr-2 h-4 w-4 flex-shrink-0 text-[#0B0B0B]"
                  />
                  <span class="text-mono-dark text-sm">{feature}</span>
                </li>
              ))
            }
          </ul>
        </div>
      </div>
    </div>
  </div>
</section>
