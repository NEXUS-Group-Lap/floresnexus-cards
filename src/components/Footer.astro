---
import { siteConfig } from '../config.ts';
import { Icon } from 'astro-icon/components';
const _b = import.meta.env.BASE_URL ?? '/';
const base = _b.endsWith('/') ? _b : _b + '/';

const iconMap = {
  facebook: 'simple-icons:facebook',
  instagram: 'simple-icons:instagram',
  linkedin: 'simple-icons:linkedin',
};
---

<footer class="bg-mono-black px-4 py-16 text-white sm:px-6 lg:px-8">
  <div class="mx-auto max-w-7xl">
    <div class="mb-12 grid grid-cols-1 gap-12 md:grid-cols-4">
      <div class="md:col-span-1">
        <a href={base} aria-label={siteConfig.site.name} class="mb-4 inline-block">
          <img
            src="/logo-white.png"
            alt={siteConfig.site.name}
            class="h-16 w-auto"
          />
        </a>
        <p class="text-mono-light text-sm leading-relaxed">
          {siteConfig.footer.tagline}
        </p>
      </div>

      {
        siteConfig.footer.columns.map((column) => (
          <div>
            <h4 class="mb-4 font-semibold">{column.title}</h4>
            <ul class="space-y-3 text-sm">
              {column.links.map((link) => (
                <li>
                  <a href={link.href} class="text-mono-light">
                    {link.name}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>

    <div
      class="border-mono-darker flex flex-col items-center justify-between border-t pt-8 md:flex-row"
    >
      <p class="text-mono-light mb-4 text-sm md:mb-0">
        &copy; {siteConfig.footer.copyright}
      </p>

      <div class="flex space-x-6">
        {
          siteConfig.footer.social.map((social) => (
            <a
              href={social.href}
              class="text-mono-light transition-colors hover:text-[#2563EB]"
              aria-label={social.name}
            >
              <Icon name={iconMap[social.icon]} class="h-5 w-5" />
            </a>
          ))
        }
      </div>
    </div>
  </div>
</footer>
