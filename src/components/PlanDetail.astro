---
import { Icon } from 'astro-icon/components';
import type { Plan } from '../content/plans.ts';

interface Props {
  plan: Plan;
}

const { plan } = Astro.props;
---

<main class="pt-16">
  <!-- Back link -->
  <div class="border-b border-[#D8D5CD] bg-white px-4 py-4 sm:px-6 lg:px-8">
    <div class="mx-auto max-w-5xl">
      <a
        href="/#pricing"
        class="flex w-fit items-center gap-2 text-sm text-mono-gray transition-colors hover:text-mono-black"
      >
        <Icon name="heroicons:arrow-left" class="h-4 w-4" />
        Back to all plans
      </a>
    </div>
  </div>

  <!-- Plan Header -->
  <section class="bg-[#0B0B0B] px-4 py-16 text-white sm:px-6 lg:px-8">
    <div class="mx-auto max-w-5xl">
      <div class="mb-4 flex flex-wrap items-center gap-3">
        {
          plan.badge && (
            <span class="rounded-full bg-[#C79A4B] px-3 py-1 text-xs font-semibold text-[#0B0B0B]">
              {plan.badge}
            </span>
          )
        }
        {
          plan.tag && (
            <span class="rounded-full border border-white/30 px-3 py-1 text-xs font-semibold text-white/60">
              {plan.tag}
            </span>
          )
        }
      </div>

      <h1 class="mb-6 text-4xl font-extrabold sm:text-5xl">{plan.name}</h1>

      <div class="mb-6 flex flex-wrap items-end gap-6">
        <div>
          <span class="text-sm text-white/60">Setup: </span>
          <span class="text-2xl font-bold">{plan.setup}</span>
        </div>
        <div>
          <span class="text-4xl font-bold">{plan.monthly}</span>
          <span class="text-white/60">{plan.period}</span>
          {
            plan.annual && (
              <span class="ml-4 text-sm text-white/50">or {plan.annual}/year</span>
            )
          }
        </div>
      </div>

      <p class="max-w-2xl text-xl leading-relaxed text-white/80">
        {plan.description}
      </p>
    </div>
  </section>

  <!-- Main Content -->
  <section class="bg-[#F7F5F0] px-4 py-16 sm:px-6 lg:px-8">
    <div class="mx-auto max-w-5xl space-y-16">

      <!-- Best For -->
      <div class="scroll-fade-up">
        <h2 class="text-mono-black mb-4 text-2xl font-bold">
          Who This Is Best For
        </h2>
        <p class="text-mono-dark max-w-3xl text-lg leading-relaxed">
          {plan.bestFor}
        </p>
      </div>

      <!-- Included / Not Included -->
      <div class="scroll-fade-up grid grid-cols-1 gap-8 md:grid-cols-2">
        <!-- Included -->
        <div class="rounded-2xl border border-[#D8D5CD] bg-white p-8 card-shadow">
          <h2 class="text-mono-black mb-6 text-xl font-bold">
            What&apos;s Included
          </h2>
          <ul class="space-y-3">
            {
              plan.features.map((feature) => (
                <li class="flex items-start">
                  <Icon
                    name="heroicons:check"
                    class="mt-0.5 mr-3 h-5 w-5 flex-shrink-0 text-[#0B0B0B]"
                  />
                  <span class="text-mono-dark">{feature}</span>
                </li>
              ))
            }
          </ul>
        </div>

        <!-- Not Included -->
        <div class="rounded-2xl border border-[#D8D5CD] bg-white p-8 card-shadow">
          <h2 class="text-mono-black mb-6 text-xl font-bold">
            What&apos;s Not Included
          </h2>
          <p class="text-mono-dark leading-relaxed">{plan.notIncluded}</p>
          {
            plan.disclaimer && (
              <p class="mt-4 text-sm leading-relaxed text-mono-gray">
                {plan.disclaimer}
              </p>
            )
          }
        </div>
      </div>

      <!-- Process Steps -->
      <div class="scroll-fade-up">
        <h2 class="text-mono-black mb-8 text-2xl font-bold">How It Works</h2>
        <div class="space-y-4">
          {
            plan.processSteps.map((item, index) => (
              <div
                class={`flex items-start gap-4 scroll-fade-up stagger-${(index % 9) + 1}`}
              >
                <div class="mt-1 flex h-8 w-8 flex-shrink-0 items-center justify-center rounded-full bg-[#0B0B0B] text-sm font-bold text-white">
                  {index + 1}
                </div>
                <div class="flex-1 rounded-2xl border border-[#D8D5CD] bg-white p-5 card-shadow">
                  <h3 class="text-mono-black mb-1 font-semibold">{item.step}</h3>
                  <p class="text-sm leading-relaxed text-mono-dark">
                    {item.description}
                  </p>
                </div>
              </div>
            ))
          }
        </div>
      </div>

      <!-- CTA -->
      <div
        class="scroll-fade-up rounded-2xl border border-[#D8D5CD] bg-white p-10 text-center card-shadow"
      >
        <h2 class="text-mono-black mb-2 text-2xl font-bold">
          {plan.requestQuote ? 'Get a Custom Quote' : 'Ready to Get Started?'}
        </h2>
        <p class="text-mono-dark mb-8 text-lg">
          {
            plan.requestQuote
              ? 'Fill out the inquiry form and we will get back to you within 24 hours.'
              : 'Complete your payment to get started. You will receive the onboarding form right after.'
          }
        </p>

        {
          plan.paymentLink ? (
            <a
              href={plan.paymentLink}
              target="_blank"
              rel="noopener noreferrer"
              class="btn-primary inline-block px-10 py-4 text-lg shadow-lg"
            >
              {plan.paymentButtonText}
            </a>
          ) : (
            <a
              href="/#contact"
              class="btn-primary inline-block px-10 py-4 text-lg shadow-lg"
            >
              {plan.paymentButtonText}
            </a>
          )
        }

        {
          !plan.requestQuote && (
            <div class="mt-6 rounded-xl border border-[#D8D5CD] bg-[#F7F5F0] px-5 py-4 text-left">
              <p class="text-xs leading-relaxed text-mono-gray">
                Payments are processed online through Stripe. Flores Nexus Group LLC does not directly store full credit card numbers. By submitting payment, you agree to the selected plan, setup fee, subscription terms, and applicable policies.
              </p>
              <div class="mt-2 flex flex-wrap gap-3 text-xs">
                <a href="/terms-of-service" class="text-mono-gray underline underline-offset-2 hover:text-mono-black transition-colors">Terms of Service</a>
                <a href="/privacy-policy" class="text-mono-gray underline underline-offset-2 hover:text-mono-black transition-colors">Privacy Policy</a>
                <a href="/cancellation-policy" class="text-mono-gray underline underline-offset-2 hover:text-mono-black transition-colors">Cancellation Policy</a>
              </div>
            </div>
          )
        }
        {
          plan.requestQuote && (
            <p class="mt-6 text-xs text-mono-gray">
              No commitment required. We will review your inquiry and follow up to schedule a call.
            </p>
          )
        }
      </div>

    </div>
  </section>
</main>
