---
import { siteConfig } from '../config.ts';
---

<section
  class="border-t border-[#D8D5CD] bg-[#F7F5F0] px-4 py-20 sm:px-6 lg:px-8"
>
  <div class="mx-auto max-w-5xl">
    <div class="scroll-fade-up mx-auto mb-12 max-w-3xl text-center">
      <h2 class="text-mono-black mb-2 text-4xl font-bold sm:text-5xl">
        {siteConfig.valueComparison.title}
      </h2>
      <p class="text-mono-dark text-2xl font-semibold">
        {siteConfig.valueComparison.subtitle}
      </p>
    </div>

    <div class="scroll-fade-up overflow-hidden rounded-2xl border border-[#D8D5CD] card-shadow">
      <!-- Header -->
      <div class="grid grid-cols-3 bg-[#0B0B0B] text-white">
        <div class="px-6 py-4 text-sm font-semibold uppercase tracking-wide"></div>
        <div class="border-l border-white/10 px-6 py-4 text-center text-sm font-semibold uppercase tracking-wide text-white/50">
          Traditional Agency
        </div>
        <div class="border-l border-white/10 px-6 py-4 text-center text-sm font-semibold uppercase tracking-wide">
          Flores Nexus Group
        </div>
      </div>

      <!-- Rows -->
      {
        siteConfig.valueComparison.rows.map((row, index) => (
          <div
            class={`grid grid-cols-3 ${index % 2 === 0 ? 'bg-white' : 'bg-[#F7F5F0]'}`}
          >
            <div class="border-t border-[#D8D5CD] px-6 py-4 text-sm font-semibold text-mono-black">
              {row.label}
            </div>
            <div class="border-t border-l border-[#D8D5CD] px-6 py-4 text-center text-sm text-mono-gray">
              {row.agency}
            </div>
            <div class="border-t border-l border-[#D8D5CD] px-6 py-4 text-center text-sm font-semibold text-mono-black">
              {row.nexus}
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>
