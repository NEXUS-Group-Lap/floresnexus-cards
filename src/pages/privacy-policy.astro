---
import PlanLayout from '../layouts/PlanLayout.astro';
import { siteConfig } from '../config.ts';

const { companyName, location, email, privacyLastUpdated } = siteConfig.legal;
---

<PlanLayout
  title="Privacy Policy — Flores Nexus Group"
  description="Privacy Policy for Flores Nexus Group LLC. Learn how we collect, use, and protect the information you provide."
>
  <div class="pt-16">

    <!-- Header -->
    <section class="bg-[#0B0B0B] px-4 py-16 text-white sm:px-6 lg:px-8">
      <div class="mx-auto max-w-4xl">
        <p class="mb-3 text-sm font-medium tracking-widest text-white/50 uppercase">Legal</p>
        <h1 class="mb-4 text-4xl font-extrabold sm:text-5xl">Privacy Policy</h1>
        <p class="text-white/60 text-sm">Last updated: {privacyLastUpdated}</p>
      </div>
    </section>

    <!-- Content -->
    <section class="bg-[#F7F5F0] px-4 py-16 sm:px-6 lg:px-8">
      <div class="mx-auto max-w-4xl space-y-12">

        <!-- Intro -->
        <div class="rounded-2xl border border-[#D8D5CD] bg-white p-8 card-shadow">
          <p class="text-mono-dark text-lg leading-relaxed">
            This Privacy Policy describes how <strong class="text-mono-black">{companyName}</strong> ("we," "us," or "our") collects, uses, and manages information submitted to us through our website, forms, email communication, and payment flows. By using our services, submitting a form, or making a payment, you agree to the practices described in this Privacy Policy.
          </p>
        </div>

        <!-- 1. Information We Collect -->
        <div class="scroll-fade-up">
          <h2 class="text-mono-black mb-6 text-2xl font-bold">1. Information We Collect</h2>
          <div class="rounded-2xl border border-[#D8D5CD] bg-white p-8 card-shadow">
            <p class="text-mono-dark mb-5 leading-relaxed">
              We may collect information that you voluntarily submit through our website forms, onboarding forms, contact forms, email communication, and payment flows. This may include:
            </p>
            <ul class="space-y-2">
              {[
                'Full name',
                'Business name',
                'Email address',
                'Phone number',
                'Business address or service area',
                'Website content, including text, descriptions, and service information',
                'Photos, logos, and images submitted for your website',
                'Social media links',
                'Messages and communication submitted through forms or email',
                'Payment-related information processed through Stripe',
              ].map((item) => (
                <li class="flex items-start gap-3 text-mono-dark">
                  <span class="mt-2 h-1.5 w-1.5 flex-shrink-0 rounded-full bg-[#0B0B0B]"></span>
                  {item}
                </li>
              ))}
            </ul>
            <p class="text-mono-gray mt-5 text-sm leading-relaxed">
              We do not directly store full credit card numbers. Payment information is processed through Stripe according to Stripe's own terms, privacy policy, and security practices.
            </p>
          </div>
        </div>

        <!-- 2. How We Use Your Information -->
        <div class="scroll-fade-up">
          <h2 class="text-mono-black mb-6 text-2xl font-bold">2. How We Use Your Information</h2>
          <div class="rounded-2xl border border-[#D8D5CD] bg-white p-8 card-shadow">
            <p class="text-mono-dark mb-5 leading-relaxed">
              Information you provide may be used for the following purposes:
            </p>
            <ul class="space-y-2">
              {[
                'Providing and delivering website services, digital business cards, and digital presence tools',
                'Communicating with clients regarding their project, onboarding, support, and service updates',
                'Processing payments, managing subscriptions, and handling billing',
                'Building, publishing, and maintaining client websites',
                'Supporting clients with questions, updates, and service requests',
                'Improving our services, processes, and internal operations',
                'Maintaining business records for legal, billing, tax, and operational purposes',
              ].map((item) => (
                <li class="flex items-start gap-3 text-mono-dark">
                  <span class="mt-2 h-1.5 w-1.5 flex-shrink-0 rounded-full bg-[#0B0B0B]"></span>
                  {item}
                </li>
              ))}
            </ul>
            <div class="mt-6 rounded-xl border border-[#D8D5CD] bg-[#F7F5F0] p-5">
              <p class="text-mono-dark text-sm leading-relaxed">
                <strong class="text-mono-black">{companyName} does not sell personal information</strong> to third parties. We do not use your personal information for unsolicited advertising, third-party marketing, or data brokerage.
              </p>
            </div>
          </div>
        </div>

        <!-- 3. Payment Processing and Stripe -->
        <div class="scroll-fade-up">
          <h2 class="text-mono-black mb-6 text-2xl font-bold">3. Payment Processing and Stripe</h2>
          <div class="rounded-2xl border border-[#D8D5CD] bg-white p-8 card-shadow">
            <p class="text-mono-dark leading-relaxed">
              {companyName} uses Stripe to process online payments, setup fees, subscriptions, and related billing transactions. When you make a payment, Stripe may collect and process payment information, including card details, billing information, transaction history, and other information required to complete the payment.
            </p>
            <p class="text-mono-dark mt-4 leading-relaxed">
              {companyName} does not directly store full credit card numbers. Stripe processes payment information according to its own terms, privacy policy, and security practices.
            </p>
            <p class="text-mono-dark mt-4 leading-relaxed">
              {companyName} is not responsible for Stripe's internal data practices, payment processing rules, account decisions, service interruptions, or policy changes. For information about how Stripe handles payment data, please review Stripe's Privacy Policy at <a href="https://stripe.com/privacy" target="_blank" rel="noopener noreferrer" class="text-mono-black underline underline-offset-2 hover:text-[#C79A4B] transition-colors">stripe.com/privacy</a>.
            </p>
          </div>
        </div>

        <!-- 4. Third-Party Tools -->
        <div class="scroll-fade-up">
          <h2 class="text-mono-black mb-6 text-2xl font-bold">4. Third-Party Tools and Services</h2>
          <div class="rounded-2xl border border-[#D8D5CD] bg-white p-8 card-shadow">
            <p class="text-mono-dark leading-relaxed">
              {companyName} may use third-party tools and services to support hosting, forms, analytics, email communication, payments, and website management. These tools operate according to their own terms and privacy policies. We select tools that support reasonable data practices, but we are not responsible for the internal policies of third-party providers.
            </p>
          </div>
        </div>

        <!-- 5. Your Information Rights -->
        <div class="scroll-fade-up">
          <h2 class="text-mono-black mb-6 text-2xl font-bold">5. Your Information Rights</h2>
          <div class="rounded-2xl border border-[#D8D5CD] bg-white p-8 card-shadow">
            <p class="text-mono-dark leading-relaxed">
              You may request updates or deletion of certain information by contacting us at <a href={`mailto:${email}`} class="text-mono-black font-semibold underline underline-offset-2 hover:text-[#C79A4B] transition-colors">{email}</a>. However, some records may need to be retained for legal, billing, tax, security, or business record purposes, and we may be unable to delete all information in every case.
            </p>
            <p class="text-mono-dark mt-4 leading-relaxed">
              If you have questions about specific information we may hold related to your account or project, please contact us in writing.
            </p>
          </div>
        </div>

        <!-- 6. Data Security -->
        <div class="scroll-fade-up">
          <h2 class="text-mono-black mb-6 text-2xl font-bold">6. Data Security</h2>
          <div class="rounded-2xl border border-[#D8D5CD] bg-white p-8 card-shadow">
            <p class="text-mono-dark leading-relaxed">
              We take reasonable precautions to protect the information we manage. However, no method of electronic transmission or storage is completely secure. We cannot guarantee absolute security of any information transmitted to or stored by us. Use of our services is at your own risk with respect to data security limitations applicable to electronic communication and online storage.
            </p>
          </div>
        </div>

        <!-- 7. Policy Updates -->
        <div class="scroll-fade-up">
          <h2 class="text-mono-black mb-6 text-2xl font-bold">7. Updates to This Policy</h2>
          <div class="rounded-2xl border border-[#D8D5CD] bg-white p-8 card-shadow">
            <p class="text-mono-dark leading-relaxed">
              {companyName} may update this Privacy Policy from time to time. Updated versions will be posted on this page with a new effective date. Continued use of our services after a policy update constitutes acceptance of the revised policy.
            </p>
          </div>
        </div>

        <!-- Contact -->
        <div class="scroll-fade-up rounded-2xl border border-[#D8D5CD] bg-[#0B0B0B] p-8 text-white">
          <h2 class="mb-4 text-xl font-bold">Questions About This Policy</h2>
          <p class="mb-1 text-white/80 leading-relaxed">{companyName}</p>
          <p class="mb-1 text-white/60 text-sm">{location}</p>
          <a
            href={`mailto:${email}`}
            class="mt-3 inline-block text-[#C79A4B] font-semibold hover:text-white transition-colors"
          >
            {email}
          </a>
        </div>

      </div>
    </section>

  </div>
</PlanLayout>
