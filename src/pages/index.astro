---
import '../styles/globals.css';

const nexusCards = [
  {
    name: "Pulpería La Morenita",
    category: "Latin Grocery",
    description: "Authentic Latin grocery store with fresh food and community favorites.",
    siteUrl: "/lamorenita/",
    preview: "/previews/lamorenita.webp",
  },
  {
    name: "Alma Closet",
    category: "Fashion & Resale",
    description: "Curated fashion — unique pieces on Poshmark, eBay, and Mercari.",
    siteUrl: "/alma/",
    preview: "/previews/alma.webp",
  },
  {
    name: "Flores Lawn Care",
    category: "Landscaping",
    description: "Professional lawn care in Cape Coral, FL — mowing, trimming, and more.",
    siteUrl: "/floreslawn/",
    preview: "/previews/floreslawn.webp",
  },
  {
    name: "Las Delicias",
    category: "Restaurant",
    description: "Authentic homestyle restaurant serving fresh, flavorful dishes made with love.",
    siteUrl: "/lasdelicias/",
    preview: "/previews/lasdelicias.webp",
  },
  {
    name: "Professional Drain Cleaning",
    category: "Plumbing",
    description: "Fast, reliable drain cleaning and unclogging services for homes and businesses.",
    siteUrl: "/professionaldraincleaning/",
    preview: "/previews/professionaldraincleaning.webp",
  },
  {
    name: "JCP General Business",
    category: "Land Clearing",
    description: "Land clearing, site preparation, demolition, and hauling across Southwest Florida.",
    siteUrl: "/JCP/",
    preview: "/JCP/images/jcp-excavator.jpg",
  },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta
      name="description"
      content="Nexus Cards — Browse business pages powered by Flores Nexus Group."
    />
    <title>Nexus Cards | Flores Nexus Group</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:opsz,wght@14..32,300;14..32,400;14..32,500;14..32,600;14..32,700;14..32,800&display=swap"
      rel="stylesheet"
    />
  </head>
  <body
    class="min-h-screen bg-mono-white text-mono-black antialiased"
    style="font-family: 'Inter', system-ui, -apple-system, sans-serif;"
  >
    <!-- ═══ HERO ═══ -->
    <section class="flex flex-col items-center justify-center px-4 py-24 text-center sm:px-6" style="background: #F7F5F0;">
      <div class="mb-4 inline-block rounded-full border border-mono-lighter bg-white/50 px-4 py-1.5 text-sm font-medium text-mono-gray">
        floresnexus.cards
      </div>
      <h1 class="max-w-3xl text-5xl font-bold tracking-tighter text-mono-black md:text-7xl">
        Nexus Cards Directory
      </h1>
      <p class="mt-6 max-w-xl text-lg text-mono-gray">
        Business pages powered by Flores Nexus Group — browse our active sites below.
      </p>
      <div class="mt-8 flex flex-wrap items-center justify-center gap-4">
        <a
          href="#directory"
          class="rounded-full bg-mono-black px-8 py-3 font-semibold text-mono-white shadow-lg transition-colors hover:bg-accent"
        >
          Browse Directory
        </a>
        <a
          href="https://floresnexus.com"
          target="_blank"
          rel="noopener noreferrer"
          class="rounded-full border-2 border-mono-black bg-transparent px-8 py-3 font-semibold text-mono-black transition-colors hover:border-accent hover:text-accent"
        >
          Get Yours at FloresNexus.com
        </a>
      </div>
    </section>

    <!-- ═══ DIRECTORY ═══ -->
    <section class="px-5 py-20 sm:px-6" id="directory">
      <div class="mx-auto max-w-[1100px]">
        <div class="scroll-fade-up mb-14 text-center">
          <p class="mb-4 text-xs font-bold uppercase tracking-[0.15em] text-accent">Directory</p>
          <h2 class="mb-3 text-[clamp(1.75rem,4vw,2.5rem)] font-extrabold leading-[1.15]">
            Active Nexus Cards
          </h2>
          <p class="mx-auto max-w-[460px] text-[1.05rem] text-mono-gray">
            Real businesses, real sites — built and managed by Flores Nexus Group.
          </p>
        </div>

        <div class="nexus-grid mx-auto max-w-[1100px]">
          {nexusCards.map((card, i) => (
            <a
              href={card.siteUrl}
              target={card.siteUrl.startsWith('http') ? '_blank' : undefined}
              rel={card.siteUrl.startsWith('http') ? 'noopener noreferrer' : undefined}
              class={`nexus-card group scroll-fade-up stagger-${i + 1}`}
            >
              <div class="nexus-card-chrome">
                <span class="nexus-card-dot"></span>
                <span class="nexus-card-dot"></span>
                <span class="nexus-card-dot"></span>
                <span class="nexus-card-urlbar">floresnexus.cards{card.siteUrl}</span>
              </div>
              <div class="site-preview">
                <img
                  src={card.preview}
                  alt={`${card.name} site preview`}
                  loading="lazy"
                  decoding="async"
                  width="900"
                  height="600"
                />
              </div>
              <div class="nexus-card-body">
                <div class="nexus-card-meta">
                  <span class="nexus-card-badge">{card.category}</span>
                  <svg class="nexus-card-arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M7 17 17 7"/><path d="M7 7h10v10"/></svg>
                </div>
                <h3 class="nexus-card-title">{card.name}</h3>
                <p class="nexus-card-description">{card.description}</p>
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>

    <!-- ═══ CTA ═══ -->
    <section class="bg-mono-black px-5 py-16 text-center sm:px-6">
      <div class="scroll-fade-up mx-auto max-w-[520px]">
        <h2 class="mb-3 text-[clamp(1.5rem,3.5vw,2rem)] font-extrabold leading-[1.2] text-mono-white">
          Want your business here?
        </h2>
        <p class="mb-8 text-[1rem] leading-[1.7] text-mono-light">
          See our plans and services at FloresNexus.com
        </p>
        <a
          href="https://floresnexus.com"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex cursor-pointer items-center gap-2 rounded-full bg-accent px-9 py-3.5 text-base font-bold text-white no-underline transition-all duration-200 hover:scale-[1.03] hover:bg-accent-hover"
        >
          Visit FloresNexus.com
          <svg class="h-[18px] w-[18px]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M7 17 17 7"/><path d="M7 7h10v10"/></svg>
        </a>
      </div>
    </section>

    <!-- ═══ FOOTER ═══ -->
    <footer class="bg-mono-darker px-5 pb-8 pt-10 sm:px-6">
      <div class="mx-auto flex max-w-[1000px] flex-col items-center gap-6">
        <div class="text-center">
          <p class="text-sm text-mono-light">
            Powered by
            <a
              href="https://floresnexus.com"
              target="_blank"
              rel="noopener noreferrer"
              class="font-semibold text-accent no-underline transition-colors duration-200 hover:underline"
            >
              Flores Nexus Group
            </a>
          </p>
        </div>

        <nav class="flex flex-wrap justify-center gap-5">
          {nexusCards.map((card) => (
            <a
              href={card.siteUrl}
              target={card.siteUrl.startsWith('http') ? '_blank' : undefined}
              rel={card.siteUrl.startsWith('http') ? 'noopener noreferrer' : undefined}
              class="text-sm text-mono-light no-underline transition-colors duration-200 hover:text-accent"
            >
              {card.name}
            </a>
          ))}
          <a href="https://floresnexus.com" target="_blank" rel="noopener noreferrer" class="text-sm text-mono-light no-underline transition-colors duration-200 hover:text-accent">FloresNexus.com</a>
        </nav>

        <div class="h-px w-full max-w-[600px] bg-white/[0.08]"></div>

        <p class="text-center text-xs text-mono-gray">
          &copy; 2026 Flores Nexus Group LLC. All rights reserved.
        </p>
      </div>
    </footer>

    <script>
      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              entry.target.classList.add('visible');
            }
          });
        },
        { threshold: 0.15 }
      );
      document.querySelectorAll('.scroll-fade-up').forEach((el) => observer.observe(el));
    </script>
  </body>
</html>
