<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Flores Nexus Cards — Mini websites for local businesses." />
    <title>Flores Nexus Cards</title>
    <style>
      *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

      body {
        font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
        background: #f4f6f8;
        color: #0d1f3c;
        min-height: 100vh;
        display: flex;
        flex-direction: column;
      }

      main {
        flex: 1;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 2rem 1.25rem;
      }

      .card {
        background: #ffffff;
        border-radius: 12px;
        box-shadow: 0 4px 24px rgba(13, 31, 60, 0.08);
        padding: 3rem 2.5rem;
        max-width: 560px;
        width: 100%;
        text-align: center;
      }

      .badge {
        display: inline-block;
        background: #1a3a6b;
        color: #ffffff;
        font-size: 0.7rem;
        font-weight: 700;
        letter-spacing: 0.12em;
        text-transform: uppercase;
        padding: 0.3rem 0.85rem;
        border-radius: 999px;
        margin-bottom: 1.5rem;
      }

      h1 {
        font-size: 2rem;
        font-weight: 800;
        color: #0d1f3c;
        line-height: 1.2;
        margin-bottom: 0.5rem;
      }

      .subtitle {
        font-size: 1.05rem;
        color: #3a6bc4;
        font-weight: 600;
        margin-bottom: 1.25rem;
      }

      .description {
        font-size: 0.95rem;
        color: #4b5563;
        line-height: 1.65;
        margin-bottom: 2rem;
      }

      .buttons {
        display: flex;
        flex-direction: column;
        gap: 0.75rem;
        margin-bottom: 1.5rem;
      }

      .btn {
        display: inline-block;
        padding: 0.8rem 1.5rem;
        border-radius: 8px;
        font-size: 0.95rem;
        font-weight: 600;
        text-decoration: none;
        transition: opacity 0.15s;
      }
      .btn:hover { opacity: 0.85; }

      .btn-primary {
        background: #1a3a6b;
        color: #ffffff;
      }

      .btn-secondary {
        background: #f4f6f8;
        color: #1a3a6b;
        border: 1.5px solid #c8d6ea;
      }

      .coming-soon {
        font-size: 0.8rem;
        color: #9ca3af;
      }

      footer {
        text-align: center;
        padding: 1.25rem;
        font-size: 0.78rem;
        color: #9ca3af;
      }

      @media (min-width: 480px) {
        .buttons {
          flex-direction: row;
          justify-content: center;
        }
        .btn {
          flex: 1;
          max-width: 220px;
        }
      }
    </style>
  </head>
  <body>
    <main>
      <div class="card">
        <span class="badge">floresnexus.cards</span>
        <h1>Flores Nexus Cards</h1>
        <p class="subtitle">Mini websites for local businesses.</p>
        <p class="description">
          This domain is used by Flores Nexus Group to host simple, fast,
          and mobile-friendly mini websites for local businesses.
        </p>
        <div class="buttons">
          <a href="https://www.floresnexus.com" class="btn btn-primary">
            Visit Flores Nexus Group
          </a>
          <a href="/lamorenita" class="btn btn-secondary">
            View Example Card
          </a>
        </div>
        <p class="coming-soon">Client Nexus Cards coming soon.</p>
      </div>
    </main>
    <footer>Powered by Flores Nexus Group</footer>
  </body>
</html>
