---
import PlanLayout from '../layouts/PlanLayout.astro';
import { stripeLinks } from '../config.ts';
import { Icon } from 'astro-icon/components';

const _b = import.meta.env.BASE_URL ?? '/';
const base = _b.endsWith('/') ? _b : _b + '/';
const applyLink = stripeLinks.careersForm;

interface Role {
  title: string;
  category: string;
  description: string;
  goodFit: string[];
  compensation: string;
  ctaLabel: string;
}

const roles: Role[] = [
  {
    title: 'Sales Representative — Florida',
    category: 'Sales',
    description:
      'Help introduce Flores Nexus Group website plans to local businesses in Florida.',
    goodFit: [
      'B2B sales or local business communication experience',
      'Strong follow-up habits',
      'Professional presentation',
      'English and Spanish communication preferred',
    ],
    compensation:
      'Sales opportunities may include flexible work arrangements and commission-based compensation. Commission details are reviewed with qualified applicants and are paid after a completed and approved sale.',
    ctaLabel: 'Apply for Sales Representative',
  },
  {
    title: 'Remote Sales Representative',
    category: 'Sales',
    description:
      'Connect with business owners remotely and help qualified clients begin the website onboarding process.',
    goodFit: [
      'Phone, email, or message-based sales experience',
      'CRM or lead tracking experience',
      'Strong written communication',
      'Self-managed follow-up',
    ],
    compensation:
      'Sales opportunities may include flexible work arrangements and commission-based compensation. Commission details are reviewed with qualified applicants and are paid after a completed and approved sale.',
    ctaLabel: 'Apply for Remote Sales',
  },
  {
    title: 'Local Field Seller',
    category: 'Sales',
    description:
      'Represent Flores Nexus Group in person with local business owners and service providers.',
    goodFit: [
      'In-person communication skills',
      'Local networking experience',
      'Professional presentation',
      'English and Spanish communication preferred',
    ],
    compensation:
      'Sales opportunities may include flexible work arrangements and commission-based compensation. Commission details are reviewed with qualified applicants and are paid after a completed and approved sale.',
    ctaLabel: 'Apply for Field Seller',
  },
  {
    title: 'Website Onboarding Assistant',
    category: 'Operations',
    description:
      'Help collect client information, organize business details, and prepare projects for production.',
    goodFit: [
      'Organized communication',
      'Detail-oriented work habits',
      'Basic website or admin knowledge',
      'English and Spanish communication preferred',
    ],
    compensation:
      'Compensation varies based on experience, responsibilities, and work structure.',
    ctaLabel: 'Apply for Onboarding Assistant',
  },
  {
    title: 'Client Support Assistant',
    category: 'Support',
    description:
      'Help clients with basic questions, update requests, and service communication.',
    goodFit: [
      'Customer service experience',
      'Clear communication',
      'Organized notes',
      'Professional follow-up',
    ],
    compensation:
      'Compensation varies based on experience, responsibilities, and work structure.',
    ctaLabel: 'Apply for Client Support',
  },
  {
    title: 'Content & Copy Assistant',
    category: 'Content',
    description:
      'Help organize business descriptions, service lists, and simple website copy for local businesses.',
    goodFit: [
      'Writing ability',
      'English and Spanish communication preferred',
      'Attention to detail',
      'Local business understanding',
    ],
    compensation:
      'Compensation varies based on experience, responsibilities, and work structure.',
    ctaLabel: 'Apply for Content Assistant',
  },
  {
    title: 'Website Developer',
    category: 'Technical',
    description:
      'Support website setup, page structure, responsive layout, content placement, and website improvements.',
    goodFit: [
      'Website development or website builder experience',
      'HTML, CSS, JavaScript, or modern framework knowledge',
      'Responsive design understanding',
      'Ability to follow project requirements',
    ],
    compensation:
      'Compensation varies based on experience, technical skill level, and project needs. For reference, website developer roles in Florida may commonly fall around the $60K–$70K annual range depending on experience, responsibilities, and company structure.',
    ctaLabel: 'Apply for Website Developer',
  },
  {
    title: 'Backend Engineer',
    category: 'Technical',
    description:
      'Support backend systems, integrations, forms, databases, payment workflows, automations, and internal tools.',
    goodFit: [
      'Backend development experience',
      'API and database knowledge',
      'Payment or form integration experience preferred',
      'Strong problem-solving and documentation habits',
    ],
    compensation:
      'Compensation varies based on experience, technical skill level, and project needs. Salary references may vary by market, role level, and technical scope.',
    ctaLabel: 'Apply for Backend Engineer',
  },
];

const categoryColor: Record<string, string> = {
  Sales: 'bg-[#0B0B0B] text-white',
  Operations: 'bg-[#1A1A1A] text-white',
  Support: 'bg-[#2D2D2D] text-white',
  Content: 'bg-[#3D3D3D] text-white',
  Technical: 'bg-[#C79A4B] text-[#0B0B0B]',
};
---

<PlanLayout
  title="Careers at Flores Nexus Group"
  description="Join the Flores Nexus Group team. We are looking for people who communicate clearly, respect process, and want to grow with a digital services company."
>
  <div class="pt-16">

    <!-- Hero -->
    <section class="bg-[#0B0B0B] px-4 py-20 text-white sm:px-6 lg:px-8">
      <div class="mx-auto max-w-4xl text-center">
        <p class="mb-4 text-sm font-medium uppercase tracking-widest text-white/50">Join Our Team</p>
        <h1 class="mb-6 text-4xl font-extrabold leading-tight sm:text-5xl lg:text-6xl">
          Careers at Flores Nexus Group
        </h1>
        <a
          href={applyLink}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-block rounded-[9px] bg-[#C79A4B] px-10 py-4 text-base font-semibold text-[#0B0B0B] transition-colors hover:bg-[#B68A3F]"
        >
          Apply Now
        </a>
      </div>
    </section>

    <!-- Welcome Intro -->
    <section class="border-t border-[#D8D5CD] bg-white px-4 py-16 sm:px-6 lg:px-8">
      <div class="mx-auto max-w-3xl">
        <div class="scroll-fade-up">
          <h2 class="text-mono-black mb-6 text-3xl font-bold">Welcome to Flores Nexus Group.</h2>
          <div class="space-y-4 text-lg leading-relaxed text-mono-dark">
            <p>
              We are building a digital services company focused on helping local businesses create a professional online presence through simple, managed website solutions.
            </p>
            <p>
              We are looking for people who communicate clearly, respect process, and want to grow with a company that values professionalism, organization, and practical results.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- Open Roles -->
    <section class="border-t border-[#D8D5CD] bg-[#F7F5F0] px-4 py-16 sm:px-6 lg:px-8">
      <div class="mx-auto max-w-5xl">
        <div class="scroll-fade-up mb-12 text-center">
          <h2 class="text-mono-black mb-3 text-3xl font-bold sm:text-4xl">Open Roles</h2>
          <p class="text-mono-dark text-lg">Sales, operations, content, and technical positions.</p>
        </div>

        <div class="grid grid-cols-1 gap-6 lg:grid-cols-2">
          {roles.map((role, index) => (
            <div class={`scroll-fade-up flex flex-col rounded-2xl border border-[#D8D5CD] bg-white card-shadow stagger-${(index % 9) + 1}`}>
              <!-- Card header -->
              <div class="rounded-t-2xl border-b border-[#D8D5CD] bg-[#F7F5F0] px-6 py-5">
                <span class={`mb-2 inline-block rounded-full px-3 py-0.5 text-xs font-semibold ${categoryColor[role.category] ?? 'bg-[#0B0B0B] text-white'}`}>
                  {role.category}
                </span>
                <h3 class="text-mono-black text-xl font-bold">{role.title}</h3>
              </div>

              <!-- Card body -->
              <div class="flex flex-1 flex-col gap-5 p-6">
                <p class="text-mono-dark leading-relaxed">{role.description}</p>

                <div>
                  <p class="mb-2 text-xs font-semibold uppercase tracking-wide text-mono-gray">Good Fit</p>
                  <ul class="space-y-1.5">
                    {role.goodFit.map((item) => (
                      <li class="flex items-start gap-2 text-sm text-mono-dark">
                        <Icon name="heroicons:check" class="mt-0.5 h-4 w-4 flex-shrink-0 text-[#0B0B0B]" />
                        {item}
                      </li>
                    ))}
                  </ul>
                </div>

                <div class="rounded-xl border border-[#D8D5CD] bg-[#F7F5F0] p-4">
                  <p class="text-xs font-semibold uppercase tracking-wide text-mono-gray mb-1">Compensation</p>
                  <p class="text-sm leading-relaxed text-mono-dark">{role.compensation}</p>
                </div>
              </div>

              <!-- Apply button -->
              <div class="px-6 pb-6">
                <a
                  href={applyLink}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="btn-primary block w-full px-6 py-3 text-center text-sm"
                >
                  {role.ctaLabel}
                </a>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Compensation Overview -->
    <section class="border-t border-[#D8D5CD] bg-white px-4 py-16 sm:px-6 lg:px-8">
      <div class="mx-auto max-w-3xl">
        <div class="scroll-fade-up">
          <h2 class="text-mono-black mb-6 text-3xl font-bold">Compensation</h2>
          <div class="space-y-4 rounded-2xl border border-[#D8D5CD] bg-[#F7F5F0] p-8 card-shadow">
            <p class="text-mono-dark leading-relaxed">
              Compensation depends on the role, experience, location, work structure, and performance model.
            </p>
            <p class="text-mono-dark leading-relaxed">
              Sales opportunities may include flexible work arrangements and commission-based compensation. Commission details are reviewed with qualified applicants and are paid after a completed and approved sale.
            </p>
            <p class="text-mono-dark leading-relaxed">
              Technical and operational roles may include hourly, project-based, or salary-based compensation depending on business needs and candidate experience.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- Application Notice + CTA -->
    <section class="border-t border-[#D8D5CD] bg-[#F7F5F0] px-4 py-16 sm:px-6 lg:px-8">
      <div class="mx-auto max-w-3xl text-center">
        <div class="scroll-fade-up">
          <h2 class="text-mono-black mb-4 text-3xl font-bold">Apply Now</h2>
          <p class="text-mono-dark mb-8 text-lg leading-relaxed">
            Submit your application and tell us about your experience, availability, and the role you are interested in.
          </p>
          <a
            href={applyLink}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-block rounded-[9px] bg-[#0B0B0B] px-10 py-4 text-base font-semibold text-white shadow-lg transition-colors hover:bg-[#C79A4B] hover:text-[#0B0B0B]"
          >
            Apply Now
          </a>
          <p class="mt-8 text-xs leading-relaxed text-mono-gray">
            All applications are reviewed by our team. Submitting an application does not guarantee employment, contractor approval, training acceptance, or a specific compensation structure.
          </p>
        </div>
      </div>
    </section>

  </div>
</PlanLayout>
