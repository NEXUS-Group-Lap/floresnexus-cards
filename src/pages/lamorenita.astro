<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Pulpería La Morenita — Nexus Card de Flores Nexus Cards." />
    <title>Pulpería La Morenita | Flores Nexus Cards</title>
    <style>
      *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

      body {
        font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
        background: #f4f6f8;
        color: #0d1f3c;
        min-height: 100vh;
        display: flex;
        flex-direction: column;
      }

      main {
        flex: 1;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 2rem 1.25rem;
      }

      .card {
        background: #ffffff;
        border-radius: 12px;
        box-shadow: 0 4px 24px rgba(13, 31, 60, 0.08);
        padding: 3rem 2.5rem;
        max-width: 520px;
        width: 100%;
        text-align: center;
      }

      .badge {
        display: inline-block;
        background: #3a6bc4;
        color: #ffffff;
        font-size: 0.7rem;
        font-weight: 700;
        letter-spacing: 0.12em;
        text-transform: uppercase;
        padding: 0.3rem 0.85rem;
        border-radius: 999px;
        margin-bottom: 1.5rem;
      }

      h1 {
        font-size: 1.85rem;
        font-weight: 800;
        color: #0d1f3c;
        line-height: 1.2;
        margin-bottom: 0.5rem;
      }

      .subtitle {
        font-size: 1rem;
        color: #3a6bc4;
        font-weight: 600;
        margin-bottom: 1.25rem;
      }

      .description {
        font-size: 0.9rem;
        color: #4b5563;
        line-height: 1.65;
        margin-bottom: 2rem;
      }

      .btn {
        display: inline-block;
        padding: 0.8rem 1.75rem;
        border-radius: 8px;
        font-size: 0.9rem;
        font-weight: 600;
        text-decoration: none;
        background: #f4f6f8;
        color: #1a3a6b;
        border: 1.5px solid #c8d6ea;
        transition: opacity 0.15s;
      }
      .btn:hover { opacity: 0.8; }

      .btn-primary {
        background: #3a6bc4;
        color: #ffffff;
        border-color: #3a6bc4;
        margin-bottom: 0.75rem;
      }

      .actions {
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
        align-items: center;
      }

      footer {
        text-align: center;
        padding: 1.25rem;
        font-size: 0.78rem;
        color: #9ca3af;
      }
    </style>
  </head>
  <body>
    <main>
      <div class="card">
        <span class="badge">Nexus Card</span>
        <h1>Pulpería La Morenita</h1>
        <p class="subtitle">Comida latina y productos de pulpería</p>
        <p class="description">
          Visita el sitio completo de Pulpería La Morenita para ver el menú,
          fotos del local y cómo contactarlos.
        </p>
        <div class="actions">
          <a href="https://nexus-group-lap.github.io/lamorenitawebsite/" class="btn btn-primary" target="_blank" rel="noopener">Visitar sitio completo →</a>
          <a href="/" class="btn">← Back to Flores Nexus Cards</a>
        </div>
      </div>
    </main>
    <footer>Powered by Flores Nexus Group</footer>
  </body>
</html>
